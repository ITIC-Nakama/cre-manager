# ─── Config Commune de Déploiement ITIC CRE ────────────────────

# ─── Backend Settings ───
SERVER_PORT=8080
SECRET_KEY=change-me-use-long-random-string-min-32-chars
REFRESH_SECRET_KEY=change-me-use-another-long-random-string
TOKEN_EXPIRATION_TIME=3600000
REFRESH_TOKEN_EXPIRATION_TIME=604800000

# ─── Database Settings ───
DB_PORT=5432
DB_NAME=itic_cre
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DDL_AUTO=update

# Debug local uniquement — laisser vide/desactive en production (les logs de bind
# exposent en clair les valeurs des requetes : emails, tokens OTP, mots de passe hashes)
# JPA_SHOW_SQL=true
# HIBERNATE_SQL_LOG_LEVEL=DEBUG
# HIBERNATE_BIND_LOG_LEVEL=TRACE

# ─── Admin Bootstrap ───
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@itic.fr
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=ITIC

# ─── Security & Mail ───
CORS_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost:5173
SWAGGER_ENABLED=true
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6
APP_BRAND_NAME="ITIC CRE"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@itic-cre.fr

# ─── Local Storage ───
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8080/api/v1/files

# ─── Gouvernance Admin ─────────────────────────────────────────
ADMIN_MAX_ACTIVE=2



# ─── File Upload Limits ────────────────────────────────────────
# MAX_FILE_SIZE=512MB
# UPLOAD_CONNECTION_TIMEOUT=120s
# MAX_CV_SIZE_MB=10
# MAX_IMAGE_SIZE_MB=15
# MAX_VIDEO_SIZE_MB=500

# ─── Comptes de test (À SUPPRIMER avant la mise en production) ──
# TEST_SEEDERS_ENABLED=false
# TEST_ADMIN_EMAIL=test.admin@itic.fr
# TEST_ADMIN_PASSWORD=Test123!
# TEST_ADMIN_FIRST_NAME=Admin
# TEST_ADMIN_LAST_NAME=Test
# TEST_ADVISOR_EMAIL=test.advisor@itic.fr
# TEST_ADVISOR_PASSWORD=Test123!
# TEST_ADVISOR_FIRST_NAME=Conseiller
# TEST_ADVISOR_LAST_NAME=Test
# TEST_ADVISOR_JOB_TITLE=Conseiller pedagogique
# TEST_STUDENT_EMAIL=test.student@itic.fr
# TEST_STUDENT_PASSWORD=Test123!
# TEST_STUDENT_FIRST_NAME=Etudiant
# TEST_STUDENT_LAST_NAME=Test

# ─── Frontend Settings (Build Time) ───
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
REACT_APP_APP_NAME="ITIC CRE"
